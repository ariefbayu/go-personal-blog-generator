package admin

import "html/template"

type AdminPageData struct {
	Title        string
	ActiveNav    string
	ExtraHead    template.HTML
	Scripts      template.HTML
	TemplatePath string
	OutputPath   string
	DBPath       string
}

templ Layout(data AdminPageData) {
	<!DOCTYPE html>
	<html class="dark" lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
			<title>{ data.Title } - Admin</title>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&amp;display=swap" rel="stylesheet"/>
			<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/admin/css/styles.css"/>
			if data.ExtraHead != "" {
				@templ.Raw(string(data.ExtraHead))
			}
		</head>
		<body>
			<div class="admin-layout">
				<!-- Sidebar -->
				<div class="sidebar">
					<div class="sidebar-inner">
						<!-- User Profile / Branding -->
						<div class="sidebar-brand">
							<div class="sidebar-avatar" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDS7stXzuX1oFmiWsscJ6UQdJia4HQqQ1S3B16IX81s9nLilZo5vQ9BHxeqlt4NLtH425M6taGrBpy855X1FQs5QZ5zR4b614Pe9OSUye680Mn-KK-3gwBlS5hLP22HQ6eC6KTcc088z_JpDFT57Ea5gYr3cATEVUOQcbT_MnZ5Hpw3pfOj4f1-4dRnnid5Cm68psmooaxIMYwQBDjYdxFvDSZ3iloQdT-DW2iwFnxZnRrdpFz8wzZDsH9O0b5tiSgtFKN7kg8CTlsh");'></div>
							<div class="sidebar-info">
								<h1 class="sidebar-title">
									<a href="/admin/dashboard" class="nav-brand-link">
										My Personal Blog
									</a>
								</h1>
								<p class="sidebar-subtitle">Admin Console</p>
							</div>
						</div>
						<!-- Navigation Links -->
						<nav class="sidebar-nav">
							<a class={ "nav-item", templ.KV("nav-item-active", data.ActiveNav == "dashboard") } href="/admin/dashboard">
								<span class="material-symbols-outlined">home</span>
								<span>Dashboard</span>
							</a>
							<a class={ "nav-item", templ.KV("nav-item-active", data.ActiveNav == "posts") } href="/admin/posts">
								<span class="material-symbols-outlined">book_2</span>
								<span>Blog Posts</span>
							</a>
							<a class={ "nav-item", templ.KV("nav-item-active", data.ActiveNav == "portfolio") } href="/admin/portfolio">
								<span class="material-symbols-outlined">work</span>
								<span>Portfolios</span>
							</a>
							<a class={ "nav-item", templ.KV("nav-item-active", data.ActiveNav == "pages") } href="/admin/pages">
								<span class="material-symbols-outlined">code</span>
								<span>Pages</span>
							</a>
							<a class={ "nav-item", templ.KV("nav-item-active", data.ActiveNav == "settings") } href="/admin/settings">
								<span class="material-symbols-outlined">settings</span>
								<span>Settings</span>
							</a>
							<a class={ "nav-item", templ.KV("nav-item-active", data.ActiveNav == "templates") } href="/admin/templates">
								<span class="material-symbols-outlined">description</span>
								<span>Templates</span>
							</a>
						</nav>
					</div>
					<!-- Logout Section -->
					<div class="sidebar-footer"></div>
				</div>
				<!-- Main Content -->
				<div class="admin-main">
					<!-- Top Bar for Mobile -->
					<header class="admin-header-mobile">
						<h1 class="admin-header-title">{ data.Title }</h1>
						<button class="admin-header-menu-btn">
							<span class="material-symbols-outlined">menu</span>
						</button>
					</header>
					<main class="admin-content">
						<div class="admin-container">
							{ children... }
						</div>
					</main>
				</div>
			</div>
			if data.Scripts != "" {
				@templ.Raw(string(data.Scripts))
			}
		</body>
	</html>
}

templ Dashboard(data AdminPageData) {
	@Layout(data) {
		<!-- Page Heading & Actions -->
		<div class="admin-page-header">
			<div>
				<h2 class="admin-page-title">Admin Dashboard</h2>
				<p class="admin-page-subtitle">Welcome to the admin interface.</p>
			</div>
			<div class="admin-page-actions">
				<button id="publish-site-btn" class="btn btn-success">
					<span class="material-symbols-outlined">publish</span>
					<span>Publish Site</span>
				</button>
				<a href="/admin/posts/new" class="btn btn-primary">
					<span class="material-symbols-outlined">add</span>
					<span>Create New Blog</span>
				</a>
			</div>
		</div>
		<!-- System Configuration Card -->
		<div class="admin-card">
			<div class="admin-card-header">
				<h3 class="admin-card-title">
					<span class="material-symbols-outlined">settings</span>
					System Configuration
				</h3>
			</div>
			<div class="admin-card-body">
				<div class="config-grid">
					<div class="config-item">
						<span class="config-label">Database Path</span>
						<code class="config-value">{ data.DBPath }</code>
					</div>
					<div class="config-item">
						<span class="config-label">Template Path</span>
						<code class="config-value">{ data.TemplatePath }</code>
					</div>
					<div class="config-item">
						<span class="config-label">Output Path</span>
						<code class="config-value">{ data.OutputPath }</code>
					</div>
				</div>
			</div>
		</div>
	}
}

templ Posts(data AdminPageData) {
	@Layout(data) {
		<!-- Page Heading & Actions -->
		<div class="admin-page-header">
			<div>
				<h2 class="admin-page-title">Blog Posts</h2>
				<p class="admin-page-subtitle">Manage your blogs here.</p>
			</div>
			<div class="admin-page-actions">
				<a href="/admin/posts/new" class="btn btn-primary">
					<span class="material-symbols-outlined">add</span>
					<span>Create New Blog</span>
				</a>
			</div>
		</div>

		<!-- Search and Table Container -->
		<div class="admin-card">
			<!-- Search Bar -->
			<div class="admin-card-header">
				<div class="admin-search">
					<span class="admin-search-icon material-symbols-outlined">search</span>
					<input class="admin-search-input" placeholder="Search posts by title or content" type="text" />
				</div>
			</div>
			<!-- Table -->
			<div class="admin-table-wrapper">
				<table class="admin-table">
					<thead>
						<tr>
							<th>Title</th>
							<th>Status</th>
							<th class="text-right">Actions</th>
						</tr>
					</thead>
					<tbody id="post-list-body">
					</tbody>
				</table>
			</div>
			<!-- Total count info -->
			<div class="admin-table-footer">
				<span class="table-count-info" id="posts-count">Loading...</span>
			</div>
		</div>
	}
}

templ PostForm(data AdminPageData) {
	@Layout(data) {
		<div class="admin-page-header">
			<div>
				<h2 class="admin-page-title">{ data.Title }</h2>
			</div>
		</div>
		<div id="post-form-container">
			<!-- Form will be rendered here by JS -->
		</div>
	}
}

templ PortfolioList(data AdminPageData) {
	@Layout(data) {
		<div class="admin-page-header">
			<div>
				<h2 class="admin-page-title">Portfolio</h2>
				<p class="admin-page-subtitle">Manage your portfolio items.</p>
			</div>
			<div class="admin-page-actions">
				<a href="/admin/portfolio/new" class="btn btn-primary">
					<span class="material-symbols-outlined">add</span>
					<span>New Item</span>
				</a>
			</div>
		</div>
		<div class="admin-card">
			<div class="admin-table-wrapper">
				<table class="admin-table">
					<thead>
						<tr>
							<th>Title</th>
							<th>Category</th>
							<th class="text-right">Actions</th>
						</tr>
					</thead>
					<tbody id="portfolio-list-body"></tbody>
				</table>
			</div>
		</div>
	}
}

templ PortfolioForm(data AdminPageData) {
	@Layout(data) {
		<div class="admin-page-header">
			<div>
				<h2 class="admin-page-title">{ data.Title }</h2>
			</div>
		</div>
		<div id="portfolio-form-container"></div>
	}
}

templ PageList(data AdminPageData) {
	@Layout(data) {
		<div class="admin-page-header">
			<div>
				<h2 class="admin-page-title">Pages</h2>
				<p class="admin-page-subtitle">Manage static pages.</p>
			</div>
			<div class="admin-page-actions">
				<a href="/admin/pages/new" class="btn btn-primary">
					<span class="material-symbols-outlined">add</span>
					<span>New Page</span>
				</a>
			</div>
		</div>
		<div class="admin-card">
			<div class="admin-table-wrapper">
				<table class="admin-table">
					<thead>
						<tr>
							<th>Title</th>
							<th>Slug</th>
							<th class="text-right">Actions</th>
						</tr>
					</thead>
					<tbody id="page-list-body"></tbody>
				</table>
			</div>
		</div>
	}
}

templ PageForm(data AdminPageData) {
	@Layout(data) {
		<div class="admin-page-header">
			<div>
				<h2 class="admin-page-title">{ data.Title }</h2>
			</div>
		</div>
		<div id="page-form-container"></div>
	}
}

templ Settings(data AdminPageData) {
	@Layout(data) {
		<div class="admin-page-header">
			<div>
				<h2 class="admin-page-title">Settings</h2>
			</div>
		</div>
		<div id="settings-container"></div>
	}
}

templ Templates(data AdminPageData) {
	@Layout(data) {
		<div class="admin-page-header">
			<div>
				<h2 class="admin-page-title">Templates</h2>
				<p class="admin-page-subtitle">Edit your blog templates.</p>
			</div>
		</div>
		<div id="templates-container"></div>
	}
}
